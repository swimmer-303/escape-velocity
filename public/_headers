# Response headers for the game's files on Cloudflare (Workers static assets read this file; it is not served).
# Vite's /assets/ files have a content hash in their names, so browsers can keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
