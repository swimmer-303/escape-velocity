# Written with AI assistance (Claude Code). See README "Use of AI tools".
[Unit]
Description=Escape Velocity NASA DONKI proxy
After=network-online.target
Wants=network-online.target

[Service]
User=deploy
WorkingDirectory=/opt/escape-velocity-api
ExecStart=/usr/bin/node /opt/escape-velocity-api/server.mjs
Environment=PORT=3001
Environment=HOST=127.0.0.1
# Class boards (teacher dashboard) are saved here as classes.json. systemd creates the folder,
# owned by the service user, and it stays writable under ProtectSystem=strict.
StateDirectory=escape-velocity
StateDirectoryMode=0700
Environment=STATE_DIR=/var/lib/escape-velocity
EnvironmentFile=-/etc/escape-velocity.env
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
