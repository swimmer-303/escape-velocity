# Written with AI assistance (Claude Code). See README "Use of AI tools".
# Caddy gets and renews the HTTPS certificates automatically (Let's Encrypt).
# DNS: Cloudflare, DNS-only (no proxy), A records -> the droplet.
playescapevelocity.com {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}

	handle {
		root * /var/www/escape-velocity/current
		try_files {path} {path}/index.html /index.html
		file_server
	}

	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# One address for everyone: www and the droplet's old sslip.io address redirect to the domain.
www.playescapevelocity.com, 143-110-195-117.sslip.io {
	redir https://playescapevelocity.com{uri} permanent
}
